  (text "Listen-only classic CAN tap. The USB-A plug is the equipment connector and is not USB."
    (exclude_from_sim no)
    (at 15.24 579.12 0)
    (effects (font (size 1.27 1.27)) (justify left))
    (uuid "56be6ef9-46ec-4f0f-8f95-f6fb2dbfff02")
  )
  (text "Wires join every pin of a net. GND_LOG and GND_BUS are separate nets and are not connected."
    (exclude_from_sim no)
    (at 15.24 584.2 0)
    (effects (font (size 1.27 1.27)) (justify left))
    (uuid "a5108a96-764d-430c-975a-548ea9c783a4")
  )
  (text "GND_LOG and GND_BUS meet nowhere. Keep an 8 mm empty slot under U2, U3, and U5."
    (exclude_from_sim no)
    (at 15.24 589.28 0)
    (effects (font (size 1.27 1.27)) (justify left))
    (uuid "7e6d53d0-3931-45f8-8f03-33ef73bd25d3")
  )
  (text "U2 TXD is tied to 3V3_LOG. GPIO5 is TP1 and does not reach the transceiver."
    (exclude_from_sim no)
    (at 15.24 594.36 0)
    (effects (font (size 1.27 1.27)) (justify left))
    (uuid "25967d8e-a52c-4352-a878-65d2c4f83211")
  )
  (text "R13 is not populated. JP1 stays open unless this board is the end of the bus."
    (exclude_from_sim no)
    (at 15.24 599.44 0)
    (effects (font (size 1.27 1.27)) (justify left))
    (uuid "d9d450bd-aa86-4df9-bab3-bf064b465a7b")
  )
  (text "Meter the equipment port before connecting J1. Pin 1 is the 24 V sense pin in this drawing."
    (exclude_from_sim no)
    (at 15.24 604.52 0)
    (effects (font (size 1.27 1.27)) (justify left))
    (uuid "0226baf4-b3af-4266-a4aa-5b4ca9ccd336")
  )
